+        private void handleListItemStart(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.framesetOk(false);
+            ArrayList<Element> stack = tb.getStack();
+            for (int i = stack.size() - 1; i > 0; i--) {
+                Element el = stack.get(i);
+                if (el.nameIs("li")) {
+                    tb.processEndTag("li");
+                    break;
+                }
+                if (isSpecial(el) && !inSorted(el.normalName(), Constants.InBodyStartLiBreakers))
+                    break;
+            }
+            closePIfInButtonScope(tb);
+            tb.insertElementFor(startTag);
+        }
+
+        private void handleDefinitionStart(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.framesetOk(false);
+            ArrayList<Element> stack = tb.getStack();
+            final int bottom = stack.size() - 1;
+            final int upper = bottom >= MaxStackScan ? bottom - MaxStackScan : 0;
+            for (int i = bottom; i >= upper; i--) {
+                Element el = stack.get(i);
+                if (inSorted(el.normalName(), Constants.DdDt)) {
+                    tb.processEndTag(el.normalName());
+                    break;
+                }
+                if (isSpecial(el) && !inSorted(el.normalName(), Constants.InBodyStartLiBreakers))
+                    break;
+            }
+            closePIfInButtonScope(tb);
+            tb.insertElementFor(startTag);
+        }
+
+        private boolean handleHtmlStart(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.error(this);
+            if (tb.onStack("template")) return false; // ignore
+            // otherwise, merge attributes onto real html (if present)
+            ArrayList<Element> stack = tb.getStack();
+            if (stack.size() > 0) {
+                Element html = tb.getStack().get(0);
+                mergeAttributes(startTag, html);
+            }
+            return true;
+        }
+
+        private boolean handleBodyStart(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.error(this);
+            ArrayList<Element> stack = tb.getStack();
+            if (stack.size() < 2 || !stack.get(1).nameIs("body") || tb.onStack("template")) {
+                return false; // ignore
+            }
+            tb.framesetOk(false);
+            // will be on stack if this is a nested body. won't be if closed (which is a variance from spec, which leaves it on)
+            Element body = tb.getFromStack("body");
+            if (body != null) mergeAttributes(startTag, body);
+            return true;
+        }
+
+        private boolean handleFramesetStart(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.error(this);
+            ArrayList<Element> stack = tb.getStack();
+            if (stack.size() < 2 || !stack.get(1).nameIs("body")) {
+                return false; // ignore
+            }
+            if (!tb.framesetOk()) {
+                return false; // ignore frameset
+            }
+            Element second = stack.get(1);
+            if (second.parent() != null)
+                second.remove();
+            // pop up to html element
+            while (stack.size() > 1)
+                stack.remove(stack.size() - 1);
+            tb.insertElementFor(startTag);
+            tb.transition(InFrameset);
+            return true;
+        }
