+    /**
+     * Flattens a single non-null command line token into the processed tokens list.
+     *
+     * @param token The current command line token.
+     * @param stopAtNonOption Specifies whether flattening should halt at the first non option.
+     * @throws ParseException if the token is an ambiguous option.
+     */
+    private void flattenToken(final String token, final boolean stopAtNonOption) throws ParseException {
+        // single or double hyphen on its own
+        if (OptionFormatter.DEFAULT_OPT_PREFIX.equals(token) || OptionFormatter.DEFAULT_LONG_OPT_PREFIX.equals(token)) {
+            tokens.add(token);
+        } else if (token.startsWith(OptionFormatter.DEFAULT_LONG_OPT_PREFIX)) {
+            flattenLongOption(token, stopAtNonOption);
+        } else if (token.startsWith(OptionFormatter.DEFAULT_OPT_PREFIX)) {
+            flattenShortOption(token, stopAtNonOption);
+        } else {
+            processNonOptionToken(token, stopAtNonOption);
+        }
+    }
+
+    /**
+     * Flattens a long option token, such as {@code --foo} or {@code --foo=bar}.
+     *
+     * @param token The current long option token.
+     * @param stopAtNonOption Specifies whether flattening should halt at the first non option.
+     * @throws AmbiguousOptionException if the long option prefix matches more than one option.
+     */
+    private void flattenLongOption(final String token, final boolean stopAtNonOption) throws AmbiguousOptionException {
+        final int pos = DefaultParser.indexOfEqual(token);
+        final String opt = pos == -1 ? token : token.substring(0, pos); // --foo
+        final List<String> matchingOpts = options.getMatchingOptions(opt);
+        if (matchingOpts.isEmpty()) {
+            processNonOptionToken(token, stopAtNonOption);
+        } else if (matchingOpts.size() > 1) {
+            throw new AmbiguousOptionException(opt, matchingOpts);
+        } else {
+            currentOption = options.getOption(matchingOpts.get(0));
+            tokens.add(OptionFormatter.DEFAULT_LONG_OPT_PREFIX + currentOption.getLongOpt());
+            if (pos != -1) {
+                tokens.add(token.substring(pos + 1));
+            }
+        }
+    }
+
+    /**
+     * Flattens a single hyphen token, which is either a known option, an abbreviated long option, or a group of short
+     * options that must be burst apart.
+     *
+     * @param token The current single hyphen token.
+     * @param stopAtNonOption Specifies whether flattening should halt at the first non option.
+     * @throws AmbiguousOptionException if the token matches more than one long option.
+     */
+    private void flattenShortOption(final String token, final boolean stopAtNonOption) throws AmbiguousOptionException {
+        if (token.length() == 2 || options.hasOption(token)) {
+            processOptionToken(token, stopAtNonOption);
+            return;
+        }
+        final List<String> matchingOpts = options.getMatchingOptions(token);
+        if (matchingOpts.isEmpty()) {
+            // requires bursting
+            burstToken(token, stopAtNonOption);
+            return;
+        }
+        if (matchingOpts.size() > 1) {
+            throw new AmbiguousOptionException(token, matchingOpts);
+        }
+        final Option opt = options.getOption(matchingOpts.get(0));
+        processOptionToken(OptionFormatter.DEFAULT_OPT_PREFIX + opt.getLongOpt(), stopAtNonOption);
+    }
