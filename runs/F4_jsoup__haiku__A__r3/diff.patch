+        // empty (void) elements, plus <image> (rewritten to <img> outside svg) and <hr>
+        private boolean inBodyStartVoid(Token.StartTag startTag, HtmlTreeBuilder tb, String name) {
+            switch (name) {
+                case "image":
+                    if (tb.getFromStack("svg") == null)
+                        return tb.process(startTag.name("img")); // change <image> to <img>, unless in svg
+                    tb.insertElementFor(startTag);
+                    return true;
+                case "hr":
+                    if (tb.inButtonScope("p")) {
+                        tb.processEndTag("p");
+                    }
+                    if (tb.inScope("select")) {
+                        tb.generateImpliedEndTags();
+                        if (tb.inScope("option") || tb.inScope("optgroup"))
+                            tb.error(this);
                     }
+                    tb.insertEmptyElementFor(startTag);
+                    tb.framesetOk(false);
+                    return true;
+                default: // area, br, embed, img, keygen, wbr
+                    tb.reconstructFormattingElements();
+                    tb.insertEmptyElementFor(startTag);
+                    tb.framesetOk(false);
+                    return true;
+            }
+        }
+
+        // math, svg: foreign content
+        private boolean inBodyStartForeign(Token.StartTag startTag, HtmlTreeBuilder tb, String name) {
+            tb.reconstructFormattingElements();
+            if (name.equals("math"))
+                tb.insertForeignElementFor(startTag, Parser.NamespaceMathml);
+            else
+                tb.insertForeignElementFor(startTag, Parser.NamespaceSvg);
+            return true;
+        }
