+     * @param availableOriginals  the number of original letters that need encoding.
+     * @param usableEncodingSize  the number of encoding characters usable in the leftmost position.
+     * @param encodingAlphabetSize the full size of the encoding alphabet, used as the base of the expansion.
+     * @return the encoded letter length.
+     */
+    private static int computeEncodedLetterLength(
+            final int availableOriginals,
+            final int usableEncodingSize,
+            final int encodingAlphabetSize) {
+        // we start with one which is our minimum, and because we do the
+        // first division outside the loop
+        int lettersSoFar = 1;
+
+        // the first division takes into account that the doNotEncode
+        // letters can't be in the leftmost place
+        int lettersLeft = availableOriginals / usableEncodingSize;
+
+        while (lettersLeft / encodingAlphabetSize >= 1) {
+            lettersLeft /= encodingAlphabetSize;
+            lettersSoFar++;
+        }
+
+        return lettersSoFar + 1;
+    }
