+    /**
+     * Computes the length, in encoding characters, needed to represent every original letter.
+     *
+     * @param lettersToEncode     the number of original letters that are not 'do not encode' characters.
+     * @param encodingCount       the total number of encoding characters.
+     * @param usableEncodingCount the number of encoding characters usable in the leftmost position.
+     * @return the length of each encoded letter.
+     */
+    private static int computeEncodedLetterLength(final int lettersToEncode,
+                                                  final int encodingCount,
+                                                  final int usableEncodingCount) {
+        // we start with one which is our minimum, and because we do the
+        // first division outside the loop
+        int lettersSoFar = 1;
+        int lettersLeft = lettersToEncode / usableEncodingCount;
+
+        while (lettersLeft / encodingCount >= 1) {
+            lettersLeft /= encodingCount;
+            lettersSoFar++;
+        }
+
+        return lettersSoFar + 1;
+    }
