+        private void closePIfInButtonScope(HtmlTreeBuilder tb) {
+            if (tb.inButtonScope("p")) {
+                tb.processEndTag("p");
+            }
+        }
+
+        private void startA(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            if (tb.getActiveFormattingElement("a") != null) {
+                tb.error(this);
+                tb.processEndTag("a");
+
+                // still on stack?
+                Element remainingA = tb.getFromStack("a");
+                if (remainingA != null) {
+                    tb.removeFromActiveFormattingElements(remainingA);
+                    tb.removeFromStack(remainingA);
+                }
+            }
+            tb.reconstructFormattingElements();
+            tb.pushActiveFormattingElements(tb.insertElementFor(startTag));
+        }
+
+        private void startLi(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.framesetOk(false);
+            ArrayList<Element> stack = tb.getStack();
+            for (int i = stack.size() - 1; i > 0; i--) {
+                Element el = stack.get(i);
+                if (el.nameIs("li")) {
+                    tb.processEndTag("li");
+                    break;
+                }
+                if (isSpecial(el) && !inSorted(el.normalName(), Constants.InBodyStartLiBreakers))
+                    break;
+            }
+            closePIfInButtonScope(tb);
+            tb.insertElementFor(startTag);
+        }
+
+        private boolean startHtml(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.error(this);
+            if (tb.onStack("template")) return false; // ignore
+            // otherwise, merge attributes onto real html (if present)
+            ArrayList<Element> stack = tb.getStack();
+            if (stack.size() > 0) {
+                Element html = stack.get(0);
+                mergeAttributes(startTag, html);
+            }
+            return true;
+        }
+
+        private boolean startBody(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.error(this);
+            ArrayList<Element> stack = tb.getStack();
+            if (stack.size() < 2 || !stack.get(1).nameIs("body") || tb.onStack("template")) {
+                return false; // ignore
+            }
+            tb.framesetOk(false);
+            // will be on stack if this is a nested body. won't be if closed (which is a variance from spec, which leaves it on)
+            Element body = tb.getFromStack("body");
+            if (body != null) mergeAttributes(startTag, body);
+            return true;
+        }
+
+        private boolean startFrameset(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.error(this);
+            ArrayList<Element> stack = tb.getStack();
+            if (stack.size() < 2 || !stack.get(1).nameIs("body")) {
+                return false; // ignore
+            }
+            if (!tb.framesetOk()) {
+                return false; // ignore frameset
+            }
+            Element second = stack.get(1);
+            if (second.parent() != null)
+                second.remove();
+            // pop up to html element
+            while (stack.size() > 1)
+                stack.remove(stack.size() - 1);
+            tb.insertElementFor(startTag);
+            tb.transition(InFrameset);
+            return true;
+        }
+
+        private boolean startForm(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            if (tb.getFormElement() != null && !tb.isParsingTemplateContents()) {
+                tb.error(this);
+                return false;
+            }
+            if (tb.inButtonScope("p")) {
+                tb.closeElement("p");
+            }
+            tb.insertFormElement(startTag, true);
+            return true;
+        }
+
+        private void startButton(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            if (tb.inButtonScope("button")) {
+                // close and reprocess
+                tb.error(this);
+                tb.processEndTag("button");
+                tb.process(startTag);
+            } else {
+                tb.reconstructFormattingElements();
+                tb.insertElementFor(startTag);
+                tb.framesetOk(false);
+            }
+        }
+
+        private void startNobr(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.reconstructFormattingElements();
+            if (tb.inScope("nobr")) {
+                tb.error(this);
+                tb.processEndTag("nobr");
+                tb.reconstructFormattingElements();
+            }
+            tb.pushActiveFormattingElements(tb.insertElementFor(startTag));
+        }
+
+        private boolean startInput(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            if (tb.fragmentContextIs("select")) {
+                tb.error(this);
+                return false;
+            }
+            if (tb.inScope("select")) {
+                tb.error(this);
+                tb.popStackToClose("select");
+            }
+            tb.reconstructFormattingElements();
+            Element el = tb.insertEmptyElementFor(startTag);
+            if (!equalsIgnoreAsciiCase(el.attr("type"), "hidden"))
+                tb.framesetOk(false);
+            return true;
+        }
+
+        private void startHr(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            closePIfInButtonScope(tb);
+            if (tb.inScope("select")) {
+                tb.generateImpliedEndTags();
+                if (tb.inScope("option") || tb.inScope("optgroup"))
+                    tb.error(this);
+            }
+            tb.insertEmptyElementFor(startTag);
+            tb.framesetOk(false);
+        }
+
+        private boolean startSelect(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            if (tb.fragmentContextIs("select")) {
+                tb.error(this);
+                return false;
+            }
+            if (tb.inScope("select")) {
+                tb.error(this);
+                tb.popStackToClose("select");
+                return true;
+            }
+            tb.reconstructFormattingElements();
+            tb.insertElementFor(startTag);
+            tb.framesetOk(false);
+            return true;
+        }
+
+        private void startHeading(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            closePIfInButtonScope(tb);
+            if (tb.hasCurrentElement() && inSorted(tb.currentElement().normalName(), Constants.Headings)) {
+                tb.error(this);
+                tb.pop();
+            }
+            tb.insertElementFor(startTag);
+        }
+
+        private void startDdDt(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            tb.framesetOk(false);
+            ArrayList<Element> stack = tb.getStack();
+            final int bottom = stack.size() - 1;
+            final int upper = bottom >= MaxStackScan ? bottom - MaxStackScan : 0;
+            for (int i = bottom; i >= upper; i--) {
+                Element el = stack.get(i);
+                if (inSorted(el.normalName(), Constants.DdDt)) {
+                    tb.processEndTag(el.normalName());
+                    break;
+                }
+                if (isSpecial(el) && !inSorted(el.normalName(), Constants.InBodyStartLiBreakers))
+                    break;
+            }
+            closePIfInButtonScope(tb);
+            tb.insertElementFor(startTag);
+        }
+
+        private void startOption(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            if (tb.inScope("select")) {
+                tb.generateImpliedEndTags("optgroup");
+                if (tb.inScope("option"))
+                    tb.error(this);
+            } else if (tb.currentElementIs("option")) {
+                tb.processEndTag("option");
+            }
+            tb.reconstructFormattingElements();
+            tb.insertElementFor(startTag);
+        }
+
+        private void startOptgroup(Token.StartTag startTag, HtmlTreeBuilder tb) {
+            if (tb.inScope("select")) {
+                tb.generateImpliedEndTags();
+                if (tb.inScope("option") || tb.inScope("optgroup"))
+                    tb.error(this);
+            } else if (tb.currentElementIs("option")) {
+                tb.processEndTag("option");
+            }
+            tb.reconstructFormattingElements();
+            tb.insertElementFor(startTag);
+        }
+
+        private boolean startOther(Token t, Token.StartTag startTag, String name, HtmlTreeBuilder tb) {
+            if (inSorted(name, Constants.InBodyStartToHead))
+                return tb.process(t, InHead);
+            Tag tag = tb.tagFor(startTag);
+            TokeniserState textState = tag.textState();
+            if (textState != null) {
+                HandleTextState(startTag, tb, textState);
+            } else if (inSorted(name, Constants.InBodyStartPClosers)) {
+                closePIfInButtonScope(tb);
+                tb.insertElementFor(startTag);
+            } else if (inSorted(name, Constants.InBodyStartApplets)) {
+                tb.reconstructFormattingElements();
+                tb.insertElementFor(startTag);
+                tb.insertMarkerToFormattingElements();
+                tb.framesetOk(false);
+            } else if (inSorted(name, Constants.InBodyStartMedia)) {
+                tb.insertEmptyElementFor(startTag);
+            } else if (inSorted(name, Constants.InBodyStartDrop)) {
+                tb.error(this);
+                return false;
+            } else {
+                tb.reconstructFormattingElements();
+                tb.insertElementFor(startTag);
             }
             return true;
         }
