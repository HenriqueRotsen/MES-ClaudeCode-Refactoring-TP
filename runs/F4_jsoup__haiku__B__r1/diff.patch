+    private static boolean handleBodyStartTag(HtmlTreeBuilderState state, Token.StartTag startTag, HtmlTreeBuilder tb) {
+        tb.error(state);
+        ArrayList<Element> stack = tb.getStack();
+        if (stack.size() < 2 || !stack.get(1).nameIs("body") || tb.onStack("template")) {
+            return false; // ignore
+        }
+        tb.framesetOk(false);
+        // will be on stack if this is a nested body. won't be if closed (which is a variance from spec, which leaves it on)
+        Element body = tb.getFromStack("body");
+        if (body != null) mergeAttributes(startTag, body);
+        return true;
+    }
+
+    private static boolean handleFramesetStartTag(HtmlTreeBuilderState state, Token.StartTag startTag, HtmlTreeBuilder tb) {
+        tb.error(state);
+        ArrayList<Element> stack = tb.getStack();
+        if (stack.size() < 2 || !stack.get(1).nameIs("body")) return false; // ignore
+        if (!tb.framesetOk()) return false; // ignore frameset
+        Element second = stack.get(1);
+        if (second.parent() != null)
+            second.remove();
+        // pop up to html element
+        while (stack.size() > 1)
+            stack.remove(stack.size() - 1);
+        tb.insertElementFor(startTag);
+        tb.transition(InFrameset);
+        return true;
+    }
