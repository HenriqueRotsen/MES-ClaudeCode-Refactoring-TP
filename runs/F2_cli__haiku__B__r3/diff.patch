+    /**
+     * Dispatches a single non-null command line token to the handler for its shape.
+     *
+     * @param token The current command line token.
+     * @param stopAtNonOption Specifies whether flattening should halt at the first non option.
+     * @throws ParseException if the token is an ambiguous option.
+     */
+    private void processToken(final String token, final boolean stopAtNonOption) throws ParseException {
+        if (OptionFormatter.DEFAULT_OPT_PREFIX.equals(token) || OptionFormatter.DEFAULT_LONG_OPT_PREFIX.equals(token)) {
+            // bare single or double hyphen
+            tokens.add(token);
+        } else if (token.startsWith(OptionFormatter.DEFAULT_LONG_OPT_PREFIX)) {
+            processLongOptionToken(token, stopAtNonOption);
+        } else if (token.startsWith(OptionFormatter.DEFAULT_OPT_PREFIX)) {
+            processShortOptionToken(token, stopAtNonOption);
+        } else {
+            processNonOptionToken(token, stopAtNonOption);
+        }
+    }
+
+    /**
+     * Handles a token of the form {@code --foo} or {@code --foo=bar}, resolving {@code --foo} against the long option names.
+     *
+     * @param token The current token, starting with a double hyphen.
+     * @param stopAtNonOption Specifies whether flattening should halt at the first non option.
+     * @throws ParseException if the long option prefix is ambiguous.
+     */
+    private void processLongOptionToken(final String token, final boolean stopAtNonOption) throws ParseException {
+        final int pos = DefaultParser.indexOfEqual(token);
+        final String opt = pos == -1 ? token : token.substring(0, pos); // --foo
+        final List<String> matchingOpts = options.getMatchingOptions(opt);
+        if (matchingOpts.isEmpty()) {
+            processNonOptionToken(token, stopAtNonOption);
+            return;
+        }
+        if (matchingOpts.size() > 1) {
+            throw new AmbiguousOptionException(opt, matchingOpts);
+        }
+        currentOption = options.getOption(matchingOpts.get(0));
+        tokens.add(OptionFormatter.DEFAULT_LONG_OPT_PREFIX + currentOption.getLongOpt());
+        if (pos != -1) {
+            tokens.add(token.substring(pos + 1));
+        }
+    }
+
+    /**
+     * Handles a token starting with a single hyphen: either a known short option, a prefix of a long option, or a
+     * cluster of short options that must be burst apart.
+     *
+     * @param token The current token, starting with a single hyphen.
+     * @param stopAtNonOption Specifies whether flattening should halt at the first non option.
+     * @throws ParseException if the token is an ambiguous long option prefix.
+     */
+    private void processShortOptionToken(final String token, final boolean stopAtNonOption) throws ParseException {
+        if (token.length() == 2 || options.hasOption(token)) {
+            processOptionToken(token, stopAtNonOption);
+            return;
+        }
+        final List<String> matchingOpts = options.getMatchingOptions(token);
+        if (matchingOpts.isEmpty()) {
+            // requires bursting
+            burstToken(token, stopAtNonOption);
+        } else {
+            processSingleHyphenLongOptionPrefix(token, matchingOpts, stopAtNonOption);
+        }
+    }
+
+    /**
+     * Handles a single-hyphen token that is a prefix of one or more long option names.
+     *
+     * @param token The current token, starting with a single hyphen.
+     * @param matchingOpts The long option names matching {@code token}; never empty.
+     * @param stopAtNonOption Specifies whether flattening should halt at the first non option.
+     * @throws AmbiguousOptionException if more than one long option matches.
+     */
+    private void processSingleHyphenLongOptionPrefix(final String token, final List<String> matchingOpts, final boolean stopAtNonOption)
+            throws AmbiguousOptionException {
+        if (matchingOpts.size() > 1) {
+            throw new AmbiguousOptionException(token, matchingOpts);
+        }
+        final Option opt = options.getOption(matchingOpts.get(0));
+        processOptionToken(OptionFormatter.DEFAULT_OPT_PREFIX + opt.getLongOpt(), stopAtNonOption);
+    }
